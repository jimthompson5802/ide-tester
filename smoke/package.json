{
    "name": "vscode-smoke-tester",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "26.3.1"
    },
    "scripts": {
        "compile": "tsc -p tsconfig.json && tsc -p helper/tsconfig.json",
        "test:unit": "node --test --test-concurrency=1 dist/tests/*.test.js",
        "smoke": "node dist/src/cli.js",
        "qualify": "node dist/src/qualify.js",
        "setup:real-chat": "node dist/src/setup-real-chat.js",
        "lint": "eslint src tests helper/extension.ts --max-warnings=0",
        "format:check": "prettier --check \"{src,tests,gui}/**/*.ts\" helper/extension.ts \"*.{json,mjs}\" helper/*.json",
        "format": "prettier --write \"{src,tests,gui}/**/*.ts\" helper/extension.ts \"*.{json,mjs}\" helper/*.json",
        "build": "npm run lint && npm run format:check && npm run compile"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.61.1",
        "@types/node": "26.0.0",
        "@types/vscode": "1.140.0",
        "eslint": "10.13.0",
        "prettier": "3.9.10",
        "typescript": "6.0.2",
        "typescript-eslint": "8.72.0"
    }
}
