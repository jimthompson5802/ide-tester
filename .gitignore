# macOS
.DS_Store
._*

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# Preserved uv/Python environments and other local virtual environments
.venv/
venv/
env/

# Python packaging and build output
build/
dist/
*.egg-info/
.eggs/

# Coverage and test output
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
.tox/
.nox/

# Local evidence and preserved reports/m1-03/preserved-workspaces data
/reports/*
!/reports/.gitkeep
*.log

# Local experiment state, preserved authenticated profiles, and future disposable workspaces
/.ide-smoke/
/profiles/
/workspaces/
/config/*.local.yaml
/config/*.local.yml

# Credentials and environment overrides (keep sanitized examples trackable)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Preserved local editor settings (including .vscode/)
.idea/
.vscode/
*.swp
*.swo
*~
